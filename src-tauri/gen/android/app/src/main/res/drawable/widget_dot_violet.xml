<?xml version="1.0" encoding="utf-8"?>
<!-- Status dot with a soft glow ring. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <size android:width="14dp" android:height="14dp" />
            <solid android:color="#40A78BFA" />
        </shape>
    </item>
    <item android:bottom="3dp" android:left="3dp" android:right="3dp" android:top="3dp">
        <shape android:shape="oval">
            <solid android:color="#FFA78BFA" />
        </shape>
    </item>
</layer-list>