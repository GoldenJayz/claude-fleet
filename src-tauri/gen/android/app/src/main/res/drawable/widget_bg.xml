<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted glass: a dark tint (keeps text readable on any wallpaper), a soft light sheen from
     the top-left, and a bright hairline edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="315"
                android:endColor="#8C0B0A14"
                android:startColor="#6624203A"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="300"
                android:centerColor="#0AFFFFFF"
                android:centerX="0.35"
                android:endColor="#00FFFFFF"
                android:startColor="#2EFFFFFF"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <stroke android:width="1dp" android:color="#3DFFFFFF" />
        </shape>
    </item>
</layer-list>
