{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Fleet",
  "version": "0.3.0",
  "identifier": "dev.claudefleet.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Claude Fleet",
        "width": 1480,
        "height": 940,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "shadow": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http: ws:; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU2MTY0QUE1NENCMDdDQkQKUldTOWZMQk1wVW9XNWo1QXNUYkRUaWhCTzM0bW45eVAxeUQwVElxQ0Nwclo1MmJJU2VmTkFxaVIK",
      "endpoints": [
        "https://github.com/GoldenJayz/claude-fleet/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
